{
  "bundle_id": "com.example.myplugin.example",
  "identity_source": "warm_alarm/example/macos/Runner/Configs/AppInfo.xcconfig; runtime not verified",
  "steps": [
    {
      "at": 0,
      "action": "focus",
      "note": "Overview; app must already be running and freshly launched"
    },
    {
      "at": 4,
      "action": "press",
      "label": "Inspect Alarm API",
      "note": "Read readiness and platform capabilities"
    },
    {
      "at": 12,
      "action": "press",
      "label": "Schedule 1 minute alarm",
      "note": "Schedules alarm id 42 for about T+72s; may play sound"
    },
    {
      "at": 78,
      "action": "hold",
      "note": "Show actual event log; absence of fired is a demo failure to investigate"
    },
    { "at": 86, "action": "hold", "note": "End take; manually stop recording" }
  ]
}
